# ==========================================================================
# Do_Bi 后端环境变量
# 复制为 .env 后填写。**密钥只存在于本文件 / 进程环境，永不落进项目数据目录。**
# ==========================================================================

# ---------- 数据目录 ----------
# 所有项目数据（真相文件 / 正文 / 审计 / checkpoint / memory.db）都写在这里
DOBI_DATA_DIR=./data

# 配置目录，留空=用 server/config/。多环境部署或测试时可以把配置挂到别处
# DOBI_CONFIG_DIR=./config

# ---------- 密钥（key 的名字必须与 config/providers.json 里的 api_key_ref 一致）----------
# 至少配置一个，否则所有需要模型的接口会返回 503 not_configured
# 也可以直接在「设置 → 模型服务」页里填写：保存会写回本文件并立即生效，无需重启
DOBI_KEY_DEEPSEEK=
DOBI_KEY_MIMO=
DOBI_KEY_OPENAI=
DOBI_KEY_DASHSCOPE=
DOBI_KEY_SILICONFLOW=

# ---------- 服务 ----------
DOBI_HOST=127.0.0.1
DOBI_PORT=8000
# 前端开发服务器地址（CORS 白名单，逗号分隔）
DOBI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 日志中对密钥脱敏后的可见前缀长度
DOBI_KEY_MASK_KEEP=4

# ---------- 预算与稳定性 ----------
# 单项目预算上限（元）；0 表示不限制
DOBI_DEFAULT_BUDGET=80.00
# 超时：连接 / 读取（秒）。长正文生成必须给足读取超时
DOBI_CONNECT_TIMEOUT=15
DOBI_READ_TIMEOUT=300
# 429 / 5xx 重试上限与基础退避（秒）
DOBI_MAX_RETRIES=3
DOBI_RETRY_BASE_DELAY=1.5
# 单章输出预留额度占比（%），与 §6.5 上下文分层预算对应
DOBI_OUTPUT_RESERVE_PCT=20
