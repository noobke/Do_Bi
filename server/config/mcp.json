      "command": "python3 mcp/example_server.py",
      "tools": [
        "lookup_setting",
        "search_reference",
        "fetch_history"
      ],
      "enabled": true,
      "status": "ok",
      "latency": 437,
      "calls": 0
    },
    {
      "name": "资料检索 reference-search",
      "transport": "http",
      "url": "https://mcp.local/reference/mcp",
      "tools": [
        "search_reference"
      ],
      "enabled": false,
      "status": "failed",
      "latency": null,
      "calls": 0,
      "error": "外部工具未响应，已改用内置检索"
    }
  ]
}